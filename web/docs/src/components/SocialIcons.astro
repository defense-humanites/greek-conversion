---
/*
 * The project's links, as the playground's masthead gives them: the
 * playground, set off by its weight, the source, and the two registries, in
 * words. Each opens in a new tab and says so, as the playground's links to
 * other sites do: the playground is a tool of its own, beside the reading.
 */
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const links = [
  { label: "Playground", href: `${base}playground/`, lead: true },
  { label: "Source", href: "https://github.com/defense-humanites/greek-conversion" },
  { label: "npm", href: "https://www.npmjs.com/package/@humanities/greek-conversion" },
  { label: "JSR", href: "https://jsr.io/@humanities/greek-conversion" },
];
---

<nav class="links" aria-label="Project">
  {
    links.map(({ label, href, lead }) => (
      <a {href} class:list={{ lead }} target="_blank" rel="noopener">
        <span class="external-tail">
          {label}
          <span class="external-mark" aria-hidden="true" />
        </span>
        <span class="sr-only"> (opens in a new tab)</span>
      </a>
    ))
  }
</nav>

<style>
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 20px;
    white-space: nowrap;
    font-size: 15px;
    font-weight: 500;
  }
  /* As the links in the text, without the faint underline at rest: the
     header says they are links. The colour stays; the 2px underline shows
     on hover, with the same fade. */
  a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--link);
    text-decoration-line: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.2em;
    text-decoration-color: transparent;
    transition: text-decoration-color 0.15s ease;
  }

  .lead {
    font-weight: 700;
  }
  @media (hover: hover) {
    a:hover {
      text-decoration-color: currentColor;
    }
  }
  /* Between a phone and 1152px, the header also holds the full name: the
     links draw closer and smaller, and leave out the new-tab mark, which
     screen readers still announce. */
  @media (min-width: 50rem) and (max-width: 71.99rem) {
    .links {
      gap: 4px 12px;
      font-size: 14px;
    }
    .links :global(.external-mark) {
      display: none;
    }
  }
</style>
