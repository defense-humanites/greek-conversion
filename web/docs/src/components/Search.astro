---
/*
 * Starlight's search, with the page held in place while it is open. On
 * iOS, Safari ignores the `overflow: hidden` Starlight puts on the body:
 * when the field takes the focus and the keyboard comes up on a page
 * scrolled down, Safari scrolls the page rather than the dialog, which
 * leaves the screen blank until the keyboard is closed. Fixing the body
 * where it was leaves Safari nothing to scroll; closing the dialog puts
 * the page back where it was, at once.
 */
import Default from "@astrojs/starlight/components/Search.astro";
---

<Default><slot /></Default>

<script>
  /*
   * The search looks in the documentation of the page, TypeScript or
   * Python, which each page gives as a filter of the index
   * (`PageTitle.astro`); the filters of the dialog can widen it to both.
   * Starlight makes the search's interface without handing it out: the
   * filter is set as it is made, when it takes its component, before its
   * first search. This script loads the interface before Starlight does,
   * which waits for the browser to be idle, and so runs first. The site
   * depends on `@pagefind/default-ui` itself, at the version Starlight
   * resolves, for the import to resolve where packages are not hoisted
   * (pnpm), and to be the module Starlight loads.
   */
  const DOCUMENTATION =
    document.querySelector<HTMLElement>("[data-documentation]")?.dataset
        .documentation === "python"
      ? "Python"
      : "TypeScript";
  if (!import.meta.env.DEV) {
    // @ts-expect-error — Missing types for @pagefind/default-ui package.
    import("@pagefind/default-ui").then(({ PagefindUI }) => {
      const components = new WeakMap<object, { $$set(props: object): void }>();
      Object.defineProperty(PagefindUI.prototype, "_pfs", {
        configurable: true,
        get(this: object) {
          return components.get(this) ?? null;
        },
        set(
          this: { triggerFilters(filters: object): void },
          component: { $$set(props: object): void } | null,
        ) {
          if (component === null) return;
          components.set(this, component);
          this.triggerFilters({ Documentation: DOCUMENTATION });
        },
      });
    });
  }

  const body = document.body;
  const root = document.documentElement;
  const OPEN = "site-search button[data-open-modal]";
  const FIELD = "site-search dialog input";
  let held: number | null = null;

  // On a page scrolled down, Safari draws the caret where the field was
  // before the page was fixed, below it, for a frame or two: the caret is
  // hidden until it has found its place.
  function hideCaret(): void {
    const field = document.querySelector<HTMLInputElement>(FIELD);
    if (!field) return;
    field.style.caretColor = "transparent";
    requestAnimationFrame(() =>
      requestAnimationFrame(() =>
        setTimeout(() => (field.style.caretColor = ""), 100)
      )
    );
  }

  function hold(): void {
    if (held !== null) return;
    held = window.scrollY;
    if (held > 0) hideCaret();
    body.style.position = "fixed";
    body.style.insetInline = "0";
    body.style.top = `-${held}px`;
  }

  // Back where it was, at once: the site scrolls smoothly to a place in the
  // page (theme.css), and a smooth return from the top ran "On this page"
  // through every section on the way.
  function release(): void {
    if (held === null) return;
    const top = held;
    held = null;
    body.style.position = "";
    body.style.insetInline = "";
    body.style.top = "";
    root.style.scrollBehavior = "auto";
    window.scrollTo(0, top);
    root.style.scrollBehavior = "";
  }

  const isOpen = () => body.hasAttribute("data-search-modal-open");
  const onButton = (event: Event) =>
    (event.target as Element | null)?.closest?.(OPEN) != null;

  // Before Starlight's own listener opens the dialog and focuses the field,
  // so that the page is fixed before the keyboard comes up. Not earlier, on
  // pointerdown: moving the page under a finger that is still down makes
  // Safari drop the tap, and the first touch after a scroll opened nothing.
  document.addEventListener(
    "click",
    (event) => onButton(event) && hold(),
    { capture: true },
  );
  // Starlight marks the body while the dialog is open, whatever opened it
  // (the field, Ctrl K), and unmarks it when it closes.
  new MutationObserver(() => isOpen() ? hold() : release())
    .observe(body, { attributes: true, attributeFilter: ["data-search-modal-open"] });
</script>
