---
/*
 * Starlight's page title, marked above it, on a page of the Python
 * documentation, with the name of the documentation, in the orange of the
 * header's selector (`SiteTitle.astro`): a reader who arrives from a search
 * engine or a link knows at once which documentation the page belongs to.
 */
import { languageOf } from "../documentations.ts";

const root = import.meta.env.BASE_URL.replace(/\/$/, "");
const python =
  languageOf(Astro.url.pathname.slice(root.length) || "/") === "python";
---

{python && <p class="documentation-mark">Python</p>}
<h1 id="_top">{Astro.locals.starlightRoute.entry.data.title}</h1>

<style>
  .documentation-mark {
    margin-block: 1rem -0.25rem;
    color: var(--to-strong);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.12em;
    line-height: 1;
    text-transform: uppercase;
  }
  h1 {
    margin-top: 1rem;
    font-size: var(--sl-text-h1);
    line-height: var(--sl-line-height-headings);
    font-weight: 600;
    color: var(--sl-color-white);
  }
  .documentation-mark + h1 {
    margin-top: 0.5rem;
  }
</style>
