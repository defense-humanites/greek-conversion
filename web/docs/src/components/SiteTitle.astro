---
/*
 * The project's identity, as the playground's masthead writes it: the
 * tessera, "greek" in cobalt and "conversion" in orange, and the product;
 * on a phone, the tessera alone.
 * The symbol follows the system's appearance, as the whole site does.
 */
const { siteTitleHref } = Astro.locals.starlightRoute;
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
---

<a href={siteTitleHref} class="identity">
  <picture>
    <source
      media="(prefers-color-scheme: dark)"
      srcset={`${base}symbol-dark.svg`}
    />
    <img src={`${base}symbol-light.svg`} alt="" width="40" height="40" />
  </picture>
  <span class="name" translate="no">greek <span>conversion</span></span>
  <span class="product">Documentation</span>
</a>

<style>
  .identity {
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
    text-decoration: none;
  }
  img {
    display: block;
    width: 40px;
    height: 40px;
  }
  .name {
    font-size: 24px;
    font-weight: 700;
    font-variation-settings: "opsz" 72;
    line-height: 1;
    letter-spacing: -0.02em;
    white-space: nowrap;
    color: var(--from);
  }
  .name span {
    color: var(--to);
  }
  .product {
    padding: 5px 7px;
    border: 1.5px solid var(--line);
    border-radius: var(--radius);
    font-size: 11px;
    font-weight: 600;
    line-height: 1;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }
  /* On a narrow screen, room for the search field and the links. */
  @media (max-width: 71.99rem) {
    .product {
      display: none;
    }
  }
  /* On a phone, the symbol alone, to leave the search field its room; the
     name stays for screen readers. */
  @media (max-width: 49.99rem) {
    .product {
      display: none;
    }
    .name {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }
</style>
