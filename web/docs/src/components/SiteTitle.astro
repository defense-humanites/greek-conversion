---
/*
 * The project's identity, as the playground's masthead writes it: the
 * tessera, "greek" in cobalt and "conversion" in orange; on a phone, the
 * tessera alone. The symbol follows the system's appearance, as the whole
 * site does. It leads to the home of the documentation the page belongs
 * to.
 *
 * Then one selector for the documentation the page belongs to, TypeScript
 * or Python (`documentations.ts`), and its version (`versions.ts`): the
 * series of the latest release (1.x) or "next", as main is before 1.0.0. It
 * reads "Python · 1.x" (on a phone, "Python" alone, to leave the search
 * field its room), and opens on the documentations, each with its versions
 * where both are deployed. A choice leads to the same page there, or to
 * the home of the other documentation when the page has no counterpart.
 * On a Python page, it takes the orange of the written, as the page's mark
 * does (`PageTitle.astro`), so that it reads at once.
 *
 * The select itself is laid over the label, transparent: the browser's own
 * list, at the keyboard and on a phone, with a label that can be shorter
 * than its options.
 */
import { counterpart, languageOf, LANGUAGES } from "../documentations.ts";
import { series, VERSIONS } from "../versions.ts";

const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const here = Astro.url.pathname;
const root = base.slice(0, -1);
const path = here.slice(root.length) || "/";
const language = languageOf(path);
const released = VERSIONS.release === null ? null : series(VERSIONS.release);
// Before 1.0.0, the root serves main alone: the next release.
const label = VERSIONS.channel === "next" || released === null
  ? "next"
  : released;
// The versions deployed, by the base each is served under.
const versions = released === null || VERSIONS.nextBase === null
  ? [{ label, root, current: true }]
  : [
    {
      label: released,
      root: VERSIONS.releaseBase,
      current: VERSIONS.channel === "release",
    },
    { label: "next", root: VERSIONS.nextBase, current: VERSIONS.channel === "next" },
  ];
const documentations = LANGUAGES.map(({ id, label: name }) => {
  const page = id === language ? path : counterpart(path);
  return {
    id,
    name,
    options: versions.map((version) => ({
      label: versions.length > 1 ? version.label : name,
      href: `${version.root}${page}`,
      current: id === language && version.current,
      // The same page in another version keeps its place; in the other
      // documentation, whose headings are not all written the same, the
      // page opens at its top.
      anchor: id === language,
    })),
  };
});
const current = LANGUAGES.find(({ id }) => id === language)!.label;
const home = `${root}${language === "python" ? "/python/" : "/"}`;
---

<a href={home} class="identity">
  <picture>
    <source
      media="(prefers-color-scheme: dark)"
      srcset={`${base}symbol-dark.svg`}
    />
    <img src={`${base}symbol-light.svg`} alt="" width="40" height="40" />
  </picture>
  <span class="name" translate="no">greek <span>conversion</span></span>
</a>
<label class:list={["picker", language]}>
  <span class="shown" aria-hidden="true">
    {current}<span class="version"> · {label}</span>
  </span>
  <select aria-label="Documentation and version">
    {
      versions.length > 1
        ? documentations.map(({ name, options }) => (
          <optgroup label={name}>
            {options.map(({ label, href, current, anchor }) => (
              <option
                value={href}
                selected={current}
                data-anchor={anchor ? "" : undefined}
              >
                {name} {label}
              </option>
            ))}
          </optgroup>
        ))
        : documentations.map(({ options: [option] }) => (
          <option
            value={option.href}
            selected={option.current}
            data-anchor={option.anchor ? "" : undefined}
          >
            {option.label}
          </option>
        ))
    }
  </select>
</label>

<script>
  for (const select of document.querySelectorAll<HTMLSelectElement>(
    ".picker select",
  )) {
    select.addEventListener("change", () => {
      const option = select.selectedOptions[0];
      location.href = select.value +
        (option?.dataset.anchor === undefined ? "" : location.hash);
    });
  }
</script>

<style>
  .identity {
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
    text-decoration: none;
    transition: scale 0.32s var(--ease-bounce);
  }
  /* Pressed, the logo shrinks and springs back, as the action buttons. */
  @media (prefers-reduced-motion: no-preference) {
    .identity:active {
      scale: var(--squish);
      transition: scale 0.06s ease-in;
    }
  }
  img {
    display: block;
    width: 40px;
    height: 40px;
  }
  .name {
    font-size: 24px;
    font-weight: 700;
    font-variation-settings: "opsz" 72;
    line-height: 1;
    letter-spacing: -0.02em;
    white-space: nowrap;
    color: var(--from);
  }
  .name span {
    color: var(--to);
  }
  /* The selector: a bordered label with a chevron, the documentation in
     ink, its version after it in the muted ink; on a Python page, in
     orange, on a tint of it. The select covers it, transparent, and its
     focus is drawn on the label. */
  .picker {
    position: relative;
    flex: none;
    display: flex;
    align-items: center;
    margin-inline-start: 14px;
    padding: 6px 24px 6px 8px;
    border: 1.5px solid var(--line);
    border-radius: var(--radius);
    color: var(--ink);
    font-size: 14px;
    font-weight: 600;
    line-height: 1;
    white-space: nowrap;
    transition: border-color 0.15s ease;
  }
  .picker .version {
    color: var(--muted);
    font-weight: 500;
  }
  .picker select {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    font: inherit;
    cursor: pointer;
  }
  .picker:has(select:focus-visible) {
    outline: 2px solid var(--link);
    outline-offset: 2px;
  }
  @media (hover: hover) {
    .picker:hover {
      border-color: var(--muted);
    }
  }
  .picker::after {
    content: "";
    position: absolute;
    inset-inline-end: 7px;
    width: 12px;
    height: 12px;
    background: currentColor;
    mask: var(--icon-chevron-down) center / contain no-repeat;
    pointer-events: none;
  }
  .picker.python {
    border-color: color-mix(in oklab, var(--to) 55%, var(--line));
    background: color-mix(in oklab, var(--to) 10%, transparent);
    color: var(--to-strong);
  }
  .picker.python .version {
    color: color-mix(in oklab, var(--to-strong) 70%, var(--muted));
  }
  @media (hover: hover) {
    .picker.python:hover {
      border-color: var(--to);
    }
  }
  /* On a phone, the symbol, then the documentation without its version,
     which its list gives, to leave the search field its room; the name
     stays for screen readers. */
  @media (max-width: 49.99rem) {
    .picker {
      margin-inline-start: 8px;
    }
    .name {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }
  @media (max-width: 29.99rem) {
    .picker .version {
      display: none;
    }
  }
</style>
