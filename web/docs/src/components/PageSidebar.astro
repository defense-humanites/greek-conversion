---
/*
 * Starlight's "On this page": the drop-down under the header below 90rem
 * (1440px), the column beside the page from there (see
 * `TwoColumnContent`). Otherwise Starlight's component, with its breakpoint
 * changed.
 */
import MobileTableOfContents from "virtual:starlight/components/MobileTableOfContents";
import TableOfContents from "virtual:starlight/components/TableOfContents";
---

{
  Astro.locals.starlightRoute.toc && (
    <>
      <div class="toc-drop-down">
        <MobileTableOfContents />
      </div>
      <div class="right-sidebar-panel">
        <div class="sl-container">
          <TableOfContents />
        </div>
      </div>
    </>
  )
}

<style>
  @layer starlight.core {
    .right-sidebar-panel {
      display: none;
      padding: 1rem var(--sl-sidebar-pad-x);
    }
    .sl-container {
      width: calc(var(--sl-sidebar-width) - 2 * var(--sl-sidebar-pad-x));
    }
    .right-sidebar-panel :global(h2) {
      color: var(--sl-color-white);
      font-size: var(--sl-text-h5);
      font-weight: 600;
      line-height: var(--sl-line-height-headings);
      margin-bottom: 0.5rem;
    }
    .right-sidebar-panel :global(:where(a)) {
      display: block;
      font-size: var(--sl-text-xs);
      text-decoration: none;
      color: var(--sl-color-gray-3);
      overflow-wrap: anywhere;
    }
    .right-sidebar-panel :global(:where(a):hover) {
      color: var(--sl-color-white);
    }
    @media (min-width: 90rem) {
      .toc-drop-down {
        display: none;
      }
      .right-sidebar-panel {
        display: block;
      }
      .sl-container {
        max-width: calc(
          (
              100vw - var(--sl-sidebar-width) - 2 * var(--sl-content-pad-x) -
                2 * var(--sl-sidebar-pad-x)
            ) * 0.25
        );
      }
    }
  }
</style>
