---
/*
 * Starlight's two columns, the page and "On this page", from 90rem (1440px)
 * rather than 72rem (1152px): below, the column would narrow the text to
 * 424px at 1152px; at 1440px, the text keeps 692px of its 720. Below 90rem,
 * "On this page" stays the drop-down under the header (`PageSidebar`).
 * Otherwise Starlight's component, with its breakpoint changed.
 */
---

<div class="two-columns">
  {
    Astro.locals.starlightRoute.toc && (
      <aside class="right-sidebar-container print:hidden">
        <div class="right-sidebar">
          <slot name="right-sidebar" />
        </div>
      </aside>
    )
  }
  <div class="main-pane"><slot /></div>
</div>

<style>
  @layer starlight.core {
    .main-pane {
      isolation: isolate;
    }

    @media (min-width: 90rem) {
      .two-columns {
        display: flex;
      }

      .right-sidebar-container {
        order: 2;
        position: relative;
        margin-inline-start: auto;
        width: max(
          var(--sl-sidebar-width),
          calc(
            var(--sl-sidebar-width) +
              (100% - var(--sl-content-width) - var(--sl-sidebar-width)) / 2
          )
        );
      }

      .right-sidebar {
        position: fixed;
        top: 0;
        border-inline-start: 1px solid var(--sl-color-hairline);
        padding-top: var(--sl-nav-height);
        width: 100%;
        height: 100vh;
        overflow-y: auto;
        scrollbar-width: none;
      }

      .main-pane {
        width: 100%;
      }

      :global([data-has-sidebar][data-has-toc]) .main-pane {
        --sl-content-margin-inline: auto 0;

        order: 1;
        width: min(
          calc(100% - var(--sl-sidebar-width)),
          calc(
            var(--sl-content-width) +
              (100% - var(--sl-content-width) - var(--sl-sidebar-width)) / 2
          )
        );
      }
    }
  }
</style>
