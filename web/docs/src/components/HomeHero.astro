---
/*
 * The home page, in one centred column: the vertical logo, which is the
 * page's heading, the project's description and the two ways in, then the
 * example given in the page's body. The playground opens in a new tab, as
 * from the header.
 * The logo follows the system's appearance, as the whole site does; its
 * tessera's halves part and join once the page has loaded, once a session.
 *
 * The home of the Python documentation (`/python/`) is the same page, with
 * `language="python"`, set apart from the first screen: the logo is "for
 * Python", in the orange of the Python pages (`SiteTitle.astro`), the
 * command that installs the package follows the description, and three
 * points say what the package is in Python, before the example.
 */
import { Icon, LinkButton } from "@astrojs/starlight/components";
import logoSource from "../../public/logo-light.svg?raw";

interface Props {
  language?: "typescript" | "python";
}
const { language = "typescript" } = Astro.props;
const python = language === "python";
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const guide = `${base}${python ? "python/" : ""}guide/getting-started/`;

/*
 * The logo, drawn in the page rather than as an image, so that the two
 * halves of the tessera can move. It is split into three drawings stacked
 * on one another, each with the logo's whole frame: each half of the
 * symbol, and the name. The halves move as elements of the page, which the
 * browser moves without drawing them again; moved inside one drawing,
 * Safari drew the whole logo again at every frame, and stuttered. The
 * light file's four colours become classes (each half, each word of the
 * name), coloured below for both appearances.
 */
let colour = 0;
const PARTS = ["grec", "latin", "word-greek", "word-conversion"];
const coloured = logoSource.trim().replace(
  / fill="#[0-9A-F]{6}"/g,
  () => ` class="${PARTS[colour++]}"`,
);
const parts = coloured.match(
  /^<svg[^>]*viewBox="([^"]*)"[^>]*>(<g transform="[^"]*">)(<g transform="[^"]*"><path class="grec"[^>]*\/><\/g>)(<g transform="[^"]*"><path class="latin"[^>]*\/><\/g>)<\/g>(<g transform="[^"]*">(?:<path[^>]*\/>)+<\/g>)<\/svg>$/,
);
if (colour !== PARTS.length || parts === null) {
  throw new Error("The logo no longer has the parts the home page moves.");
}
const [, viewBox, symbol, grec, latin, name] = parts;
const drawing = (className: string, content: string) =>
  `<svg class="${className}" viewBox="${viewBox}" aria-hidden="true">${content}</svg>`;
const halves = drawing("half grec", symbol + grec + "</g>") +
  drawing("half latin", symbol + latin + "</g>");
const wordmark = drawing("name", name);
---

<section class="home-hero not-content">
  <div class="intro">
    <h1 id="_top" class="logo">
      <span class="art" role="img" aria-label="greek conversion">
        <span class="tessera" set:html={halves} />
        <Fragment set:html={wordmark} />
      </span>
      {python && <span class="flavor">for Python</span>}
    </h1>
    <script is:inline>
      // The tessera moves once the page has loaded and drawn a frame or two:
      // started while the browser still lays the page out and loads its
      // fonts, it lost its first frames (Safari jumped to the halves at
      // their widest). Not when the page took over 2.5s to load, or has
      // already been scrolled: the reader is reading, and the jolt would
      // pass for the layout moving. Once a session: a later visit finds the
      // logo still; a visit where it did not play does not count.
      (() => {
        const KEY = "gc-tessera";
        try {
          if (sessionStorage.getItem(KEY)) return;
        } catch {
          // Storage refused: the animation plays at every visit.
        }
        const play = () => {
          if (performance.now() > 2500) return;
          requestAnimationFrame(() =>
            requestAnimationFrame(() => {
              if (scrollY > 0) return;
              document.querySelector(".logo")?.classList.add("play");
              try {
                sessionStorage.setItem(KEY, "1");
              } catch {
                // As above.
              }
            })
          );
        };
        if (document.readyState === "complete") play();
        else addEventListener("load", play, { once: true });
      })();
    </script>
    <p class="description">
      <span class="line"
        >{python ? "A Python library" : "A TypeScript library"} that converts
        Ancient, Byzantine, and Modern&nbsp;Greek</span
      >{" "}
      <span class="line"
        >between Greek&nbsp;script, Beta&nbsp;Code, and Latin&nbsp;script, with
        atomic&nbsp;options</span
      >{" "}
      <span class="line"
        >composed into standards‑based presets, and
        information‑loss&nbsp;diagnostics.</span
      >
    </p>
    {
      python && (
        <button
          class="install"
          type="button"
          data-copy="pip install greek-conversion"
          aria-label="Copy the command: pip install greek-conversion"
        >
          <code>
            <span class="prompt" aria-hidden="true">$</span> pip install
            greek-conversion
          </code>
          <span class="copy" aria-hidden="true">
            <svg
              class="idle"
              viewBox="0 0 24 24"
              width="18"
              height="18"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <rect width="14" height="14" x="8" y="8" rx="2" />
              <path
                d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"
              />
            </svg>
            <Icon name="approve-check" class="done" size="18px" />
          </span>
        </button>
      )
    }
    <div class="actions">
      <LinkButton href={guide} icon="right-arrow">
        Get started
      </LinkButton>
      <LinkButton
        href={`${base}playground/`}
        variant="minimal"
        target="_blank"
        rel="noopener"
      >
        <span
          >Try the <span class="external-tail"
            >playground<span class="external-mark" aria-hidden="true" /></span
          ><span class="sr-only"> (opens in a new tab)</span></span
        >
      </LinkButton>
    </div>
  </div>
  {
    python && (
      <ul class="points">
        <li>
          <b>Nothing else to install.</b> The library runs in a JavaScript
          engine embedded in Python, with the results of its TypeScript
          original.
        </li>
        <li>
          <b>Typed.</b> Editors and type checkers know every option and its
          values, in snake_case.
        </li>
        <li>
          <b>A corpus in one call.</b> <code>convert_many()</code> converts a
          list of strings at once, and pays for a call into the engine once.
        </li>
      </ul>
    )
  }
  <div class="example"><slot /></div>
</section>

<script>
  // The installation command, copied; the icon says so for 1.5s.
  for (const button of document.querySelectorAll<HTMLButtonElement>(
    ".home-hero .install",
  )) {
    button.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(button.dataset.copy ?? "");
      } catch {
        return;
      }
      button.classList.add("copied");
      setTimeout(() => button.classList.remove("copied"), 1500);
    });
  }
</script>

<style>
  /* "for Python", under the name, in the orange of the Python pages. */
  .flavor {
    display: block;
    margin-top: 0.75rem;
    color: var(--to-strong);
    font-size: 1.125rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    line-height: 1;
    text-transform: uppercase;
  }
  /* The command, as a raised panel of code with its copy icon. */
  .install {
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    margin: 0;
    padding: 0.625rem 0.75rem 0.625rem 1rem;
    border: 1.5px solid color-mix(in oklab, var(--to) 45%, var(--line));
    border-radius: var(--radius);
    background: var(--raised);
    color: var(--ink);
    font: inherit;
    cursor: pointer;
    transition: border-color 0.15s ease;
  }
  @media (hover: hover) {
    .install:hover {
      border-color: var(--to);
    }
  }
  .install code {
    padding: 0;
    border: 0;
    background: none;
    font-family: var(--face-code);
    font-size: 1rem;
    white-space: nowrap;
  }
  .install .prompt {
    color: var(--muted);
    user-select: none;
  }
  .install .copy {
    display: grid;
    color: var(--muted);
  }
  .install .copy > :global(*) {
    grid-area: 1 / 1;
  }
  .install :global(.done),
  .install.copied :global(.idle) {
    visibility: hidden;
  }
  .install.copied :global(.done) {
    visibility: visible;
    color: var(--to-strong);
  }
  /* Three points, in a row from 800px, one under another before. */
  .points {
    display: grid;
    gap: 1rem;
    max-width: 58rem;
    margin: 0;
    padding: 0;
    list-style: none;
    color: var(--muted);
    font-size: 0.9375rem;
    line-height: 1.5;
    text-align: start;
  }
  .points li {
    margin: 0;
    padding: 1rem 1.125rem;
    border: 1px solid var(--line);
    border-top: 3px solid color-mix(in oklab, var(--to) 70%, var(--line));
    border-radius: var(--radius);
    background: var(--raised);
  }
  .points b {
    display: block;
    margin-bottom: 0.25rem;
    color: var(--ink);
  }
  @media (min-width: 50rem) {
    .points {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .home-hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2.5rem;
    padding-block: 2.5rem 0.9375rem;
  }
  /* The vertical logo is centred on itself: so is what follows it. */
  .intro {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
    text-align: center;
  }
  h1 {
    margin: 0;
    line-height: 0;
  }
  /* 70% of the screen, between that of a 360px screen, the page's
     narrowest (`theme.css`), and 19rem; the three drawings on one another,
     in the logo's frame. */
  .art {
    position: relative;
    /* Inline, on the heading's baseline as the image it replaces was, so
       that what follows keeps its distance. */
    display: inline-block;
    width: clamp(15.75rem, 70vw, 19rem);
    aspect-ratio: 308 / 168;
  }
  .art :global(svg),
  .tessera {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  /* The colours of the two logo files, by appearance. */
  .logo :global(.grec),
  .logo :global(.word-greek) {
    fill: #2f4fa8;
  }
  .logo :global(.latin) {
    fill: #dd6a33;
  }
  .logo :global(.word-conversion) {
    fill: #c85a26;
  }
  @media (prefers-color-scheme: dark) {
    .logo :global(.grec),
    .logo :global(.word-greek) {
      fill: #c9d3ec;
    }
    .logo :global(.latin),
    .logo :global(.word-conversion) {
      fill: #e08a5e;
    }
  }
  /*
   * Once the page has loaded, the tessera's halves part and join again, as
   * a conversion that loses nothing: they draw apart along the break (the
   * line of their offsets, 8 by 3, 7 units each: 2.12% of the frame's
   * width, 1.46% of its height), the right one leaning further, to 4°,
   * about the point it turns on (59.7%, 29.1% of the frame), quickly, as
   * if sprung (175ms); they pause there (40ms), then fall back to their
   * places, faster and faster (220ms), the right one settling back to its
   * 2° as it lands, without overshooting, which would close the break. As
   * they arrive, the whole tessera bounces, from its centre (50.2%, 27.6%),
   * as the site's buttons do but more markedly, the closing beat: it
   * shrinks to 90% in 60ms, springs past its size to 106%, then settles
   * with a last small give (98.5%), 0.5s in all. Once the page has loaded,
   * once a session (`play`, set by the script above),
   * for those who do not ask for less motion.
   */
  @media (prefers-reduced-motion: no-preference) {
    .logo.play :global(.half) {
      animation-duration: 0.435s;
      animation-delay: 0.1s;
      animation-fill-mode: both;
    }
    .logo.play :global(.half.grec) {
      animation-name: tessera-grec;
    }
    .logo.play :global(.half.latin) {
      transform-origin: 59.7% 29.1%;
      animation-name: tessera-latin;
    }
    .logo.play .tessera {
      transform-origin: 50.2% 27.6%;
      animation-name: tessera-bounce;
      animation-duration: 0.5s;
      animation-delay: 0.515s;
      animation-fill-mode: both;
    }
  }
  @keyframes tessera-bounce {
    0% {
      scale: 1;
      animation-timing-function: ease-in;
    }
    12% {
      scale: 0.9;
      animation-timing-function: cubic-bezier(0.2, 0, 0.3, 1);
    }
    42% {
      scale: 1.06;
      animation-timing-function: ease-in-out;
    }
    72% {
      scale: 0.985;
      animation-timing-function: ease-in-out;
    }
    100% {
      scale: 1;
    }
  }
  @keyframes tessera-grec {
    0% {
      transform: none;
      animation-timing-function: cubic-bezier(0.25, 0.6, 0.3, 1);
    }
    40.2%,
    49.4% {
      transform: translate(-2.12%, -1.46%);
      animation-timing-function: cubic-bezier(0.45, 0, 0.85, 0.45);
    }
    100% {
      transform: none;
    }
  }
  @keyframes tessera-latin {
    0% {
      transform: none;
      animation-timing-function: cubic-bezier(0.25, 0.6, 0.3, 1);
    }
    40.2%,
    49.4% {
      transform: translate(2.12%, 1.46%) rotate(2deg);
      animation-timing-function: cubic-bezier(0.45, 0, 0.85, 0.45);
    }
    100% {
      transform: none;
    }
  }
  /* Balanced lines on a narrow screen. Where the page is wider than its
     720px column, three lines broken where the sentence turns, the middle
     one the widest: a little wider than the example, which keeps its
     width. */
  .description {
    max-width: 48rem;
    margin: 0;
    font-size: 1.25rem;
    line-height: 1.5;
    color: var(--muted);
    text-wrap: balance;
  }
  /* On a phone, a size between the text's and the buttons' keeps the
     sentence to six lines, which Chrome balances, and no more. */
  @media (max-width: 26rem) {
    .description {
      font-size: 1.0625rem;
    }
  }
  @media (min-width: 68.75rem) {
    .description .line {
      display: block;
    }
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
  }
  .actions :global(.sl-link-button) {
    margin: 0;
  }
  /* On a phone, both buttons on one line. */
  @media (max-width: 30rem) {
    .actions {
      gap: 0.5rem;
    }
    .actions :global(.sl-link-button) {
      padding-inline: 0.75rem;
    }
  }
  .example {
    width: 100%;
    max-width: 46rem;
    min-width: 0;
  }
  @media (min-width: 50rem) {
    .home-hero {
      gap: 3rem;
      /* With the page's own margin under it, as much room under the example
         as above the logo. */
      padding-block: 4rem 2.5rem;
    }
  }
</style>
