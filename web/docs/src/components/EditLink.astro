---
/*
 * Starlight's edit link, which leads to GitHub: like every link that leaves
 * the documentation, it opens in a new tab and says so.
 */
import { icon } from "../../../shared/icons.ts";

const { editUrl } = Astro.locals.starlightRoute;
const label = Astro.locals.t("page.editLink");
---

{
  editUrl && (
    <a href={editUrl} class="sl-flex print:hidden" target="_blank" rel="noopener">
      <Fragment set:html={icon("pencil")} />
      <span>
        <span class="external-tail">
          {label}
          <span class="external-mark" aria-hidden="true" />
        </span>
        <span class="sr-only"> (opens in a new tab)</span>
      </span>
    </a>
  )
}

<style>
  /* As the links in the text: the colour stays (muted, as a page's
     footnote), the 2px underline shows on hover, with the same fade. */
  a {
    gap: 0.5rem;
    align-items: center;
    color: var(--sl-color-gray-3);
    text-decoration-line: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.2em;
    text-decoration-color: transparent;
    transition: text-decoration-color 0.15s ease;
  }
  @media (hover: hover) {
    a:hover {
      text-decoration-color: currentColor;
    }
  }
  a :global(.icon) {
    flex: none;
    width: 1.125rem;
    height: 1.125rem;
  }
</style>
