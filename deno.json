{
  "name": "@humanities/greek-conversion",
  "version": "1.0.0-beta.8",
  "license": "MIT",
  "lock": false,
  "exports": {
    ".": "./src/mod.ts",
    "./document": "./src/document.ts"
  },
  "publish": {
    "include": [
      "README.md",
      "LICENSE",
      "CHANGELOG.md",
      "MIGRATION.md",
      "RELEASING.md",
      "docs/**/*.md",
      "src/**/*.ts"
    ]
  },
  "exclude": [
    "npm/",
    "scripts/npm_smoke.mjs"
  ],
  "fmt": {
    "include": [
      "src/**/*.ts",
      "tests/**/*.ts",
      "scripts/**/*.ts",
      "scripts/**/*.mjs",
      ".github/**/*.yml",
      "*.json"
    ],
    "exclude": [
      "!scripts/npm_smoke.mjs"
    ]
  },
  "lint": {
    "exclude": [
      "!scripts/npm_smoke.mjs"
    ]
  },
  "tasks": {
    "check": "deno fmt --check && deno lint && deno check && deno task doc && deno run --allow-read scripts/generate_preset_docs.ts --check",
    "doc": "deno doc --lint src/mod.ts src/document.ts",
    "docs:presets": "deno run --allow-read --allow-write scripts/generate_preset_docs.ts",
    "test": "deno test",
    "publish:check": "deno publish --dry-run --check=all",
    "npm:build": "deno run -A scripts/build_npm.ts",
    "npm:check": "deno task npm:build && node scripts/npm_smoke.mjs && cd npm && npm pack --dry-run"
  },
  "imports": {
    "@deno/dnt": "jsr:@deno/dnt@0.43.2",
    "@std/assert": "jsr:@std/assert@1.0.19"
  }
}
